# پوشه‌های تولید شده توسط بیلدهای دات‌نت
[Bb]in/
[Oo]bj/
.vs/
.vscode/

# خروجی‌های پکیج‌های ناگت (NuGet)
packages/
*.nupkg
# استثنا: پکیج رسمی SDK سامانه مودیان که در nuget.org عمومی نیست و باید commit شود
!LocalNuGet/*.nupkg

# کلید خصوصی و گواهی امضای سامانه مودیان - هرگز نباید commit شود
Keys/*.pem
Keys/*.cer
Keys/*.crt

# تنظیمات کاربر و فایل‌های مخفی
*.user
*.userosscache
*.sln.docstates

# فایل‌های مربوط به تست‌ها و کاورج (در صورت وجود)
TestResults/
*.coverage
*.coveragexml

# فایل‌های دیتابیس لوکال (اگر استفاده می‌کنید)
*.db
*.sdf
*.sqlite

# سایر موارد رایج
.DS_Store
Thumbs.db
